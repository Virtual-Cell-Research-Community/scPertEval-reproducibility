  "hyperparameter_policy": "published-or-established-config-no-hpo",
  "condition_id_format": "{context}::{perturbation}::{dose:g}nM",
  "dataset": "srivatsan-trapnell-2020-sciplex3",
  "contexts": ["A549", "K562", "MCF7"],
  "dose_unit": "nM",
  "doses": [10.0, 100.0, 1000.0, 10000.0],
  "n_drugs": 9,
  "n_point_conditions": 36,
  "n_population_conditions": 33,
  "validation_seed": 42,
  "validation_conditions": [
    "Alvespimycin (17-DMAG) HCl::100nM",
    "Flavopiridol HCl::10nM",
    "Hesperadin::100nM",
    "Quisinostat (JNJ-26481585) 2HCl::100nM"
  ],
  "folds": [
    {
      "id": "holdout-a549",
      "test_context": "A549",
      "train_contexts": ["K562", "MCF7"],
      "n_point_conditions": 36,
      "n_population_conditions": 33
    },
    {
      "id": "holdout-k562",
      "test_context": "K562",
      "train_contexts": ["A549", "MCF7"],
      "n_point_conditions": 36,
      "n_population_conditions": 33
    },
    {
      "id": "holdout-mcf7",
      "test_context": "MCF7",
      "train_contexts": ["A549", "K562"],
      "n_point_conditions": 36,
      "n_population_conditions": 33
    }
  ],
  "population_minimum_cells_per_context": 50,
  "gene_panel": {
    "scope": "global-across-all-contexts",
    "components": ["top-8192-hvgs", "top-100-de-genes-per-retained-drug-dose"],
    "n_hvgs": 8192,
    "hvg_flavor": "seurat",
    "n_de_genes_per_condition": 100,
    "de_method": "t-test",
    "de_reference": "pooled-controls-across-all-contexts",
