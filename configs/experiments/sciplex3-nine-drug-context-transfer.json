{
  "schema_version": 1,
  "id": "sciplex3-nine-drug-context-transfer",
  "task": "leave-one-context-out",
  "models": ["state", "cpa", "biolord", "scdisinfact", "trvae", "no-change", "fold-mean", "linear"],
  "training_seeds": [42, 43, 44],
  "prediction_population_policy": {
    "mode": "match-observed",
    "control_sampling": "with-replacement-if-needed"
